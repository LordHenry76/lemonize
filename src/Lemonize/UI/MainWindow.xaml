<ui:ThemedWindow x:Class="Lemonize.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:Lemonize.UI"
                 Title="Lemonize" Width="820" Height="600" MinWidth="680" MinHeight="520"
                 WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Click="OnSettings" ToolTip="Settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/lemonize.png" RenderOptions.BitmapScalingMode="HighQuality" Width="40" Height="40" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Lemonize" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Convert, compress and edit files right where you drag them." Style="{StaticResource Dim}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- Drop zone -->
            <Border x:Name="DropZone" CornerRadius="16" Background="{StaticResource Surface}" AllowDrop="True"
                    DragEnter="OnZoneDragEnter" DragLeave="OnZoneDragLeave" Drop="OnZoneDrop" MouseLeftButtonUp="OnBrowse" Cursor="Hand">
                <Grid>
                    <Rectangle x:Name="DashedBorder" RadiusX="16" RadiusY="16" StrokeDashArray="6 4" StrokeThickness="2" Stroke="{StaticResource Border}" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/lemonize.png" RenderOptions.BitmapScalingMode="HighQuality" Width="72" Height="72" HorizontalAlignment="Center" />
                        <TextBlock Text="Drop files here" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                        <TextBlock Text="or click to choose files" Style="{StaticResource Dim}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- How it works -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Anywhere in Windows" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,12"
                           Text="Start dragging files in File Explorer or on the desktop, then hold a key. A wheel opens around the pointer: drop on a choice." />
                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock><Run Text="Shift" FontWeight="SemiBold" Foreground="{StaticResource Accent}" /><Run Text="  Convert" /></TextBlock>
                        <TextBlock Style="{StaticResource Dim}" Text="JPEG, PNG, HEIC, MP4, MP3, PDF, DOCX, EPUB, ZIP…" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock><Run Text="Alt" FontWeight="SemiBold" Foreground="{StaticResource Accent}" /><Run Text="  Tools" /></TextBlock>
                        <TextBlock Style="{StaticResource Dim}" Text="Compress, edit, trim, merge PDFs, metadata, QR…" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock><Run Text="Ctrl" FontWeight="SemiBold" Foreground="{StaticResource Accent}" /><Run Text="  Actions" /></TextBlock>
                        <TextBlock Style="{StaticResource Dim}" Text="Share, float, copy, move, copy path, terminal" />
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0"
                           Text="Converted files are saved next to the originals. Everything runs on this PC; nothing is uploaded." />
            </StackPanel>
        </Grid>

        <!-- Components -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="14,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <ProgressBar x:Name="FfmpegProgress" Width="120" Maximum="1" Visibility="Collapsed" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <Button x:Name="FfmpegButton" Content="Download FFmpeg" Style="{StaticResource Primary}" Click="OnDownloadFfmpeg" />
                </StackPanel>
                <WrapPanel x:Name="ComponentList" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Version and credit -->
        <ui:CreditLine Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,2,0" />
    </Grid>
</ui:ThemedWindow>
