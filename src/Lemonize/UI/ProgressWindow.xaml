<ui:ThemedWindow x:Class="Lemonize.UI.ProgressWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:Lemonize.UI"
                 xmlns:jobs="clr-namespace:Lemonize.Jobs"
                 Title="Lemonize — Progress" Width="360" SizeToContent="Height"
                 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
                 ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False">
    <ui:ThemedWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <ui:StateVisibilityConverter x:Key="StateVis" />
    </ui:ThemedWindow.Resources>

    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" />
        </Border.Effect>
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="14,10,8,4" MouseLeftButtonDown="OnHeaderDrag" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/lemonize.png" RenderOptions.BitmapScalingMode="HighQuality" Width="16" Height="16" Margin="0,0,6,0" />
                    <TextBlock Text="Lemonize" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Clear finished" Click="OnClear" FontSize="13" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Hide" Click="OnHide" FontSize="13" />
                </StackPanel>
            </Grid>
            <ListBox x:Name="List" Margin="6,0,6,8" MaxHeight="300" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type jobs:Job}">
                        <Grid Margin="4,2" MouseLeftButtonUp="OnJobClick" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Thumbnail}" Width="30" Height="30" Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12.5" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Detail}" Margin="0,1,0,4" />
                                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                             Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding State, Converter={StaticResource StateVis}}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Margin="4,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Canceled">
                                                    <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Cancel" FontSize="11" Padding="6"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}" Click="OnCancel" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</ui:ThemedWindow>
