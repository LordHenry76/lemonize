<ui:ThemedWindow x:Class="Lemonize.UI.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:Lemonize.UI"
                 Title="Lemonize Settings" Width="520" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock Text="General" Style="{StaticResource Heading}" />
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Language" VerticalAlignment="Center" Width="190" />
            <ComboBox x:Name="LanguageBox" />
        </DockPanel>
        <CheckBox x:Name="DragWheel" Content="Open the wheel when dragging files with Shift or Ctrl" />
        <CheckBox x:Name="Startup" Content="Start Lemonize when I sign in" />
        <CheckBox x:Name="ContextMenuBox" Content="Add “Lemonize…” to the File Explorer right-click menu" />
        <CheckBox x:Name="ProgressWin" Content="Show the progress window" />
        <CheckBox x:Name="Reveal" Content="Show converted files in File Explorer when done" />

        <TextBlock Text="Output" Style="{StaticResource Heading}" Margin="0,18,0,8" />
        <RadioButton x:Name="Beside" Content="Save next to the original file" GroupName="Out" />
        <DockPanel>
            <RadioButton x:Name="Custom" Content="Save to folder:" GroupName="Out" DockPanel.Dock="Left" />
            <Button Content="Choose…" DockPanel.Dock="Right" Click="OnChooseFolder" Margin="8,0,0,0" />
            <TextBlock x:Name="FolderLabel" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </DockPanel>
        <CheckBox x:Name="Overwrite" Content="Tools modify the original file instead of making a copy" Margin="0,8,0,4" />

        <TextBlock Text="Quality" Style="{StaticResource Heading}" Margin="0,18,0,8" />
        <DockPanel>
            <TextBlock Text="JPEG / WebP quality" VerticalAlignment="Center" Width="190" />
            <TextBlock x:Name="QualityLabel" DockPanel.Dock="Right" Width="36" TextAlignment="Right" VerticalAlignment="Center" />
            <Slider x:Name="Quality" Minimum="40" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnQualityChanged" />
        </DockPanel>
        <DockPanel Margin="0,6,0,0">
            <TextBlock Text="Jobs at the same time" VerticalAlignment="Center" Width="190" />
            <TextBlock x:Name="ParallelLabel" DockPanel.Dock="Right" Width="36" TextAlignment="Right" VerticalAlignment="Center" />
            <Slider x:Name="Parallel" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnParallelChanged" />
        </DockPanel>

        <TextBlock Text="FFmpeg" Style="{StaticResource Heading}" Margin="0,18,0,8" />
        <DockPanel>
            <Button Content="Browse…" DockPanel.Dock="Right" Click="OnBrowseFfmpeg" Margin="8,0,0,0" />
            <TextBox x:Name="FfmpegPath" ToolTip="Leave empty to find FFmpeg automatically" />
        </DockPanel>
        <TextBlock x:Name="FfmpegStatus" Style="{StaticResource Dim}" Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="80" Click="OnCancel" />
            <Button Content="Save" IsDefault="True" Style="{StaticResource Primary}" MinWidth="80" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</ui:ThemedWindow>
